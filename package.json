{
  "name": "dsh-ensp",
  "version": "0.2.1",
  "description": "Automate Huawei eNSP labs: generate .topo files, start and stop devices, and push configuration one command at a time with per-command error reporting.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ensp",
    "huawei",
    "vrp",
    "network-simulation",
    "mcp",
    "automation"
  ],
  "type": "module",
  "license": "GPL-3.0-or-later",
  "main": "./src/dsh/index.mjs",
  "exports": {
    ".": "./src/dsh/index.mjs",
    "./dsh": "./src/dsh/index.mjs",
    "./core": "./src/core/index.mjs",
    "./topology": "./src/core/topology.mjs",
    "./build": "./src/core/build.mjs",
    "./console": "./src/core/console.mjs",
    "./launcher": "./src/core/launcher.mjs",
    "./provision": "./src/core/provision.mjs",
    "./presets": "./src/core/presets.mjs",
    "./calibrate": "./src/core/calibrate.mjs",
    "./mcp": "./src/mcp/server.mjs"
  },
  "bin": {
    "ensp": "src/cli/ensp.mjs",
    "dsh-ensp-mcp": "src/mcp/server.mjs"
  },
  "files": [
    "src",
    "docs",
    "scripts",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/core.test.mjs",
    "probe": "node src/cli/ensp.mjs probe",
    "docs": "node scripts/gen-scenarios-doc.mjs",
    "docs:check": "node scripts/gen-scenarios-doc.mjs --check"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": {
    "name": "lizi600jin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lizi600jin/dsh-ensp.git"
  },
  "homepage": "https://github.com/lizi600jin/dsh-ensp#readme",
  "bugs": {
    "url": "https://github.com/lizi600jin/dsh-ensp/issues"
  }
}
