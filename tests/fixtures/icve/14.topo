        <txttip left="672" top="186" right="736" bottom="203" content="静态默认" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="177" top="626" right="785" bottom="690" content="要求：&#x0D;&#x0A;1、网络分为内网、外网，内网包括总部和两个分部网络，内、外网能彼此互访&#x0D;&#x0A;2、内网总部网络运行OSPF协议，总部与分部1之间配置静态路由、与分部2之间配置RIP协议&#x0D;&#x0A;3、内网通过默认路由访问外网" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
    </txttips>
