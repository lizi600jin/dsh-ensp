        <txttip left="290" top="465" right="377" bottom="497" content="vlan 10&#x0D;&#x0A;10.1.3.0/24" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="487" top="465" right="574" bottom="497" content="vlan 20&#x0D;&#x0A;10.1.4.0/24" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="157" top="148" right="267" bottom="165" content="192.168.1.0/30" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="381" top="167" right="491" bottom="184" content="192.168.1.4/30" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="532" top="101" right="627" bottom="118" content="100.1.1.0/24" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="765" top="407" right="860" bottom="424" content="200.1.1.0/24" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="9" top="517" right="972" bottom="690" content="NAT综合实操&#x0D;&#x0A;&#x0D;&#x0A;实操拓扑如图所示，由公网和私网组成，私网分为总部LAN和分公司LAN,各网段网络号标示如图，按要求完成配置&#x0D;&#x0A;&#x0D;&#x0A;1、总部LAN和分公司LAN分别划分两个VLAN:VLAN10、VLAN20，完成相应配置，使得不同VLAN之间互通&#x0D;&#x0A;2、配置相应路由，使得私网、公网各自独立路由可达，但私网路由不可发布到公网，公网路由不可发布到私网&#x0D;&#x0A;3、在边界路由器AR1上配置ACL，使得分公司vlan10的PC能够访问总部的网络，VLAN20的PC只能访问总部的服务器&#x0D;&#x0A;4、在边界路由器AR1上配置NAPT，使得总部的用户可以访问公网，分公司只有VLAN10的PC可以访问公网（公有IP地址池：100.1.1.3-100.1.1.5）&#x0D;&#x0A;5、在边界路由器AR1上配置NAT SERVER，使得公网PC可以访问私网总部WWW服务器&#x0D;&#x0A;&#x0D;&#x0A;" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="21" top="193" right="70" bottom="210" content="分公司" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="269" top="191" right="303" bottom="208" content="总部" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
    </txttips>
</topo>
