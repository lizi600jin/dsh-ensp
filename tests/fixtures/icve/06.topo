    <txttips>
        <txttip left="36" top="204" right="70" bottom="221" content="LAN1" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="466" top="198" right="500" bottom="215" content="LAN2" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="77" top="383" right="134" bottom="400" content="VLAN 10" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="301" top="384" right="358" bottom="401" content="VLAN 20" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="5" top="432" right="696" bottom="558" content="扩展ACL配置&#x0D;&#x0A;&#x0D;&#x0A;1、LAN1划分VLAN10、VLAN20，配置单臂路由，使得VLAN之间互通&#x0D;&#x0A;2、路由器上配置相应路由，使得全网互通&#x0D;&#x0A;3、在R1上配置扩展ACL,使得：&#x0D;&#x0A;a、VLAN10中的PC只能以WEB方式访问LAN2服务器S1，只能以FTP方式访问LAN2服务器S2，其他均不能访问&#x0D;&#x0A;b、VLAN20中的第一台PC只能访问S1，其它PC除了不能PING，其他方式都可以访问LAN2的服务器&#x0D;&#x0A;IP地址自行规划" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
    </txttips>
</topo>
